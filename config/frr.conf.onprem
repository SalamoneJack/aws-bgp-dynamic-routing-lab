# FRR BGP config for the ONPREM-SIM router (AS 65002)
# Place at: /etc/frr/frr.conf
# Replace <CLOUD_PRIVATE_IP> and <ONPREM_PRIVATE_IP> with values from terraform output bgp_config_summary

frr version 8.x
frr defaults traditional
hostname onprem-router
log syslog informational
!
router bgp 65002
 bgp router-id <ONPREM_PRIVATE_IP>
 !
 no bgp ebgp-requires-policy
 !
 neighbor <CLOUD_PRIVATE_IP> remote-as 65001
 neighbor <CLOUD_PRIVATE_IP> description cloud-router
 !
 address-family ipv4 unicast
  ! Advertise the OnPrem-Sim VPC CIDR into BGP
  network 10.20.0.0/16
  !
  neighbor <CLOUD_PRIVATE_IP> activate
 exit-address-family
!
line vty
!
